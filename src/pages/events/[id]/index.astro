---
import Layout from '../../../layouts/Layout.astro';
import SaveEvent from '../../../components/SaveEvent';
import StagePanel from '../../../components/StagePanel';
import Practice from '../../../components/Practice';
import EventResourcePreview from '../../../components/EventResourcePreview.astro';
import {events,eventModules,lessonUrl,readMinutes} from '../../../lib/catalog';
export function getStaticPaths(){return events.map(event=>({params:{id:event.id},props:{event}}))}
const {event}=Astro.props;const lessons=eventModules(event);const terms=lessons.flatMap(m=>m.terms.map(t=>({...t,lessonId:m.id}))).filter((t,i,a)=>a.findIndex(x=>x.term.toLowerCase()===t.term.toLowerCase())===i);const review=terms.slice(0,24);
---
<Layout title={event.name}><div class="page-top"><div class="breadcrumb"><a href="/">Events</a><span>/</span><span>{event.subject}</span></div><div class="event-heading"><div><h1>{event.name}</h1><div class="event-meta"><span>Grades {event.gradeMin}–{event.gradeMax}</span><span>{event.teamMax===1?'Individual':event.teamMin+'–'+event.teamMax+' members'}</span><span>{event.season}</span></div></div><SaveEvent client:load id={event.id}/></div></div><div class="event-shell"><div><StagePanel client:load event={event}/>{event.notes.map(note=><div class="notice">{note} {event.name==='Accounting'&&<a href="https://connect.fbla.org/headquarters/blob.php?id=9475&systemFolder=files" target="_blank" rel="noreferrer">Compare national guidance ↗</a>}</div>)}{event.topicTitle&&<section style="margin-top:28px"><h3>This season’s topic</h3><p class="serif" style="font-size:1.3rem;margin-bottom:8px">{event.topicTitle}</p><p class="section-description">Read the complete prompt and deliverable requirements in your <a href={event.sourceUrl} target="_blank" rel="noreferrer">2026–2027 event guide ↗</a>. Use the lessons to learn the skills, then create your own competition work.</p></section>}
<section id="lessons"><div class="section-line"><h2>Lessons</h2><span class="small muted">{lessons.length} lessons</span></div><p class="section-description">Read the lessons and try the examples. Use the linked sources if you need more detail.</p><ol class="lesson-list">{lessons.map((m,i)=><li><a href={lessonUrl(event.id,m.id)}><span class="lesson-index">{String(i+1).padStart(2,'0')}</span><div><h3>{m.title}</h3><p>{m.summary}</p></div><span class="lesson-time">{readMinutes(m)} min read</span></a></li>)}</ol></section>
<section id="quick-review"><div class="section-line"><h2>Quick review</h2><a href={'/events/'+event.id+'/review/'} class="plain-link">Open printable review →</a></div><p class="section-description">A recap after the lessons. Try explaining each term before reading the definition.</p><dl class="review-grid">{review.slice(0,8).map(t=><div class="review-term"><dt>{t.term}</dt><dd>{t.definition}</dd></div>)}</dl></section><EventResourcePreview event={event}/><Practice client:visible event={event} terms={terms}/><noscript><p>The lessons and review are available without JavaScript. Enable JavaScript to save progress or use practice tools.</p></noscript></div>
<aside class="event-sidebar"><h3>What this guide covers</h3><ul>{(event.knowledgeAreas.length?event.knowledgeAreas:['Research & planning','Developing your work','Evidence & evaluation','Communication & presentation']).map(a=><li>{a}</li>)}</ul>{event.weights.length>0&&<><h3 style="margin-top:25px">Published test weights</h3><ul>{event.weights.map(w=><li>{w.area}: {w.items} questions</li>)}</ul></>}<h3 style="margin-top:25px">Official guides and sources</h3><a class="source-label" href={'/events/'+event.id+'/resources/'}>Study materials &amp; Drive practice →</a><a class="source-label" href={event.sourceUrl} target="_blank" rel="noreferrer">Maryland event guide ↗</a><a class="source-label" href="https://www.fbla.org/high-school/competitive-events/" target="_blank" rel="noreferrer">National event guidelines ↗</a><a class="source-label" href="https://www.mbaresearch.org/local-educators/student-organizations/fbla/" target="_blank" rel="noreferrer">MBA Research study guides ↗</a><a class="source-label" href="/maryland/">Maryland dates & preparation →</a><p class="inline-alert">These lessons were written for this site. Follow FBLA’s current event guidelines for competition requirements. Sources checked October 27, 2026.</p></aside></div></Layout>

