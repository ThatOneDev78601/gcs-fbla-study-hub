---
import {getEntry,render} from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import LessonActions from '../../../../components/LessonActions';
import TopicCheck from '../../../../components/TopicCheck';
import {events,eventModules,lessonUrl,readMinutes,sources} from '../../../../lib/catalog';
export function getStaticPaths(){return events.flatMap(event=>eventModules(event).map((lesson,index)=>({params:{id:event.id,lesson:lesson.id},props:{event,lesson,index}})))}
const {event,lesson,index}=Astro.props;const entry=await getEntry('lessons',lesson.id);if(!entry)throw new Error('Missing lesson '+lesson.id);const {Content,headings}=await render(entry);const lessons=eventModules(event);const previous=lessons[index-1],next=lessons[index+1];const lessonSources=sources.filter(s=>lesson.sourceIds.includes(s.id));
---
<Layout title={lesson.title}><div class="page-top" style="padding-bottom:0"><div class="breadcrumb"><a href="/">Events</a><span>/</span><a href={'/events/'+event.id+'/'}>{event.name}</a><span>/</span><span>Study guide</span></div></div><div class="reader"><aside class="reader-nav" data-pagefind-ignore><p>In this lesson</p>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}<a href="#lesson-sources">Sources & further reading</a><div style="border-top:1px solid var(--line);margin-top:18px;padding-top:12px"><a href={'/events/'+event.id+'/'}>← All {event.name} lessons</a></div></aside><article class="reader-body" data-pagefind-body data-pagefind-filter={'event:'+event.name}><header><div class="small muted">Lesson {index+1} of {lessons.length} · {readMinutes(lesson)} min read</div><h1 data-pagefind-meta="title">{lesson.title}</h1><p class="summary">{lesson.summary}</p></header><details class="mobile-toc" data-pagefind-ignore><summary>In this lesson</summary>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</details><div class="prose"><Content/></div>{lesson.questions[0]&&<TopicCheck client:visible question={lesson.questions[0]}/>}<LessonActions client:load lessonKey={event.id+'/'+lesson.id}/><nav class="reader-pagination" aria-label="Lesson navigation">{previous?<a href={lessonUrl(event.id,previous.id)}>← {previous.title}</a>:<a href={'/events/'+event.id+'/'}>← Event guide</a>}{next?<a href={lessonUrl(event.id,next.id)}>{next.title} →</a>:<a href={'/events/'+event.id+'/#practice'}>Try the practice tools →</a>}</nav><section id="lesson-sources" style="margin-top:45px"><h3>Sources and further reading</h3><p class="small muted">These sources were used to write the lesson. Follow the links for more detail. Last reviewed October 27, 2026.</p><ul class="small muted" style="line-height:2">{lessonSources.map(s=><li><a href={s.url} target="_blank" rel="noreferrer">{s.title} ↗</a> · {s.publisher} · {s.access}</li>)}<li><a href={event.sourceUrl} target="_blank" rel="noreferrer">{event.name}: Maryland event guide ↗</a></li></ul></section></article></div></Layout>

