---
import Layout from '../../../layouts/Layout.astro';
import {events,eventModules,lessonUrl} from '../../../lib/catalog';
export function getStaticPaths(){return events.map(event=>({params:{id:event.id},props:{event}}))}
const {event}=Astro.props;const lessons=eventModules(event);
---
<Layout title={event.name+' quick review'}><div class="page-top"><div class="breadcrumb"><a href="/">Events</a><span>/</span><a href={'/events/'+event.id+'/'}>{event.name}</a><span>/</span><span>Quick review</span></div><h1>{event.name}<br/>Quick review</h1><p>Try defining each term before reading the answer. Return to the lessons if you need an explanation or example.</p><button class="button button-outline no-print" id="print-review">Print review</button></div><article class="prose">{lessons.map(m=><section><h2>{m.title}</h2><p>{m.summary}</p><dl>{m.terms.map(t=><div class="review-term"><dt>{t.term}</dt><dd>{t.definition}</dd></div>)}</dl><p class="no-print"><a href={lessonUrl(event.id,m.id)}>Revisit this lesson →</a></p></section>)}</article></Layout><script>document.getElementById('print-review')?.addEventListener('click',()=>window.print());</script>

